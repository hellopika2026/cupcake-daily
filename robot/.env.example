# Sao chép file này thành ".env" rồi điền. File .env KHÔNG bao giờ được đưa lên GitHub.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://XXXXXXXX.supabase.co
# Khóa "service_role" (bí mật, chỉ để trên máy bạn và GitHub Secrets, KHÔNG dán vào web)
SUPABASE_SERVICE_KEY=

# --- Cách 1 (ưu tiên, chạy trên máy bạn): Antigravity CLI ---
# Lệnh gọi agy. Mặc định: đưa nội dung qua stdin. Có thể dùng {prompt_file} (đường dẫn file chứa nội dung)
# hoặc {prompt} (chính nội dung) nếu agy của bạn cần truyền dạng tham số.
AGY_COMMAND=agy
AGY_TIMEOUT=300

# --- Cách 2 (dự phòng): Gemini API (khóa miễn phí từ Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
